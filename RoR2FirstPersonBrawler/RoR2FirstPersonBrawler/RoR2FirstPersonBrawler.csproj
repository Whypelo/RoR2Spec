<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Адаптация проекта под Visual Studio 2026 (Insiders).
    Изменения относительно версии под VS2022:
      * SDK-style csproj вместо legacy-формата (ToolsVersion/явный список <Compile>) —
        стандарт для MSBuild из VS2026 и dotnet CLI; все .cs подхватываются автоматически.
      * TargetFramework net35 сохранён — это требование Mono-рантайма Risk of Rain 2,
        а не версии Visual Studio.
      * LangVersion 12 — новый компилятор Roslyn из VS2026 позволяет использовать
        современный синтаксис C# поверх net35 (для старых файлов достаточно 7.3+,
        повышение безопасно: обратно совместимо).
      * Post-build копирование через целевые элементы MSBuild вместо cmd-обёртки xcopy —
        кроссплатформенно (работает и в VS Insiders на Windows Arm64 / в CodeSpaces),
        не «ломает» сборку, если путь к игре не задан.
      * Убраны жёсткие ссылки на $(MSBuildToolsPath) цели — их больше нет в SDK-проектах.
  -->

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>RoR2FirstPersonBrawler</RootNamespace>
    <AssemblyName>RoR2FirstPersonBrawler</AssemblyName>
    <LangVersion>12</LangVersion>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- В SDK-проектах по умолчанию включён GenerateAssemblyInfo: отключаем,
         чтобы атрибуты сборки остались под нашим контролем (при необходимости). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Не тянуть случайные NuGet-зависимости: все игровые референсы — локальные DLL.
         Единственный пакет — reference assemblies для net35 (аналог targeting pack из
         VS Installer; в VS2026 отдельный компонент ставить не нужно). -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- RoR2/BepInEx — x86-сборки (MSIL без 32BITREQUIRED), поэтому сам плагин
         тоже компилируется как x86 (AnyCPU+Prefer32Bit в net35 не поддерживается).
         Это убирает предупреждение MSB3270 «несоответствие архитектур MSIL/x86». -->
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyOriginatorKeyFile></AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <!-- Legacy API-совместимость поведения компилятора для UnityEngine-сборок -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!-- Критично для SDK-style проекта net35: без отключенияimplicit-ссылок на
         Microsoft.NETCore.App проект пытается разрешить System.* из .NET Core
         и сборка/IntelliSense падают ещё до компиляции игровых ссылок. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <!-- Сборка не должна «падать» только из-за отсутствующих DLL игры:
         сначала покажем внятную диагностику (см. Target DiagnoseGameReferences). -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3245;MSB3243</MSBuildWarningsAsMessages>
    <!-- Папка для «ручного» подключения зависимостей: все *.dll из неё
         становятся ссылками автоматически, путь к игре тогда не нужен. -->
    <LibRefPath>$(MSBuildProjectDirectory)\lib</LibRefPath>
  </PropertyGroup>

  <!--
    Диагностика: если DLL игры/BepInEx не найдены, показываем ОДНО понятное
    сообщение со всеми недостающими файлами и текущим значением RoR2Path —
    вместо десятков безликих CS0246 («Не удалось найти тип ... RoR2/UnityEngine/BepInEx»).
    Причина именно в отсутствии путей к игре, а не в коде мода.
  -->
  <Target Name="DiagnoseGameReferences" BeforeTargets="BeforeBuild;CoreCompile">
    <ItemGroup>
      <!-- Проверка выполняется ВНУТРИ target: на уровне глобального ItemGroup
       %(Identity) недоступен в Condition, что вызывало ошибку MSBuild
       «ссылка на встроенные метаданные "Identity" ... не разрешена в условии».
       Файл считается найденным, если он есть в lib\ ИЛИ по пути к игре. -->
      <!-- UnityEngine.Networking.dll намеренно НЕ включён: в современных билдах
           RoR2 (Unity 2019.4+) классической UNet-сборки нет — типы NetworkServer/
           NetworkIdentity реплицируются в Assembly-CSharp.dll. Мод использует их
           только оттуда, отдельная ссылка не требуется. -->
      <!-- UnityEngine.dll (legacy-сборка, Version=0.0.0.0) обязателен: в него
           ссылаются типы из Assembly-CSharp (например, CharacterBase : MonoBehaviour),
           и без него компилятор выдаёт «Тип "MonoBehaviour" определен в сборке, на
           которую нет ссылки». Если в Managed\ его нет — включите режим lib\ и
           положите UnityEngine.dll рядом (см. README). -->
      <_GameRefSpec Include="Assembly-CSharp.dll;UnityEngine.dll;UnityEngine.CoreModule.dll;UnityEngine.AnimationModule.dll;UnityEngine.PhysicsModule.dll;UnityEngine.AssetBundleModule.dll;BepInEx.dll;0Harmony.dll;R2API.dll" />
      <_FoundGameRefs Include="@(_GameRefSpec->'$(LibRefPath)\%(Identity)')" Condition="Exists('$(LibRefPath)\%(_GameRefSpec.Identity)')" />
      <_FoundGameRefs Include="@(_GameRefSpec->'$(RoR2ManagedPath)\%(Identity)')" Condition="Exists('$(RoR2ManagedPath)\%(_GameRefSpec.Identity)')" />
      <_FoundGameRefs Include="@(_GameRefSpec->'$(BepInExCorePath)\%(Identity)')" Condition="Exists('$(BepInExCorePath)\%(_GameRefSpec.Identity)')" />
      <_FoundGameRefs Include="@(_GameRefSpec->'$(BepInExPluginPath)\%(Identity)')" Condition="Exists('$(BepInExPluginPath)\%(_GameRefSpec.Identity)')" />
      <_MissingGameRefs Include="@(_GameRefSpec)" Exclude="@(_FoundGameRefs->'%(Filename)%(Extension)')" />
    </ItemGroup>
    <Error Condition="'@(_MissingGameRefs)' != '' And '$(DiagnoseOnly)' == 'true'"
           Text="Отсутствуют сборки: @(_MissingGameRefs, ' | '). RoR2Path = '$(RoR2Path)', lib\ = '$(LibRefPath)'. Скопируйте DLL в lib\ (см. README, раздел «Ручное подключение зависимостей») или задайте верный путь к игре." />
    <Warning Condition="'@(_MissingGameRefs)' != ''"
             Text="[RoR2FirstPersonBrawler] ВНИМАНИЕ: не найдено @(_MissingGameRefs, ', '). RoR2Path = '$(RoR2Path)', папка lib\ = '$(LibRefPath)'. Ошибки CS0246 (неизвестные типы RoR2/UnityEngine/BepInEx) вызваны ИМЕННО отсутствием этих DLL, а не кодом. Проще всего скопировать их в lib\ — см. README, раздел «Ручное подключение зависимостей»." />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!--
    Путь к установленной игре задаётся одним из способов (в порядке приоритета):
      1. RoR2FirstPersonBrawler.csproj.user  ->  <RoR2Path>...</RoR2Path>  (не в git)
      2. Переменная окружения RoR2_PATH
      3. Значение по умолчанию: стандартная Steam-директория
  -->
  <PropertyGroup>
    <!-- Убираем возможные хвостовые обратные слеши (частая причина «путь не найден»,
         особенно при копировании из проводника: "D:\Steam\Risk of Rain 2\") -->
    <RoR2Path Condition="'$(RoR2Path)' != ''">$(RoR2Path.TrimEnd('\'))</RoR2Path>
    <RoR2Path Condition="'$(RoR2Path)' == '' And '$(RoR2_PATH)' != ''">$(RoR2_PATH.TrimEnd('\'))</RoR2Path>
    <RoR2Path Condition="'$(RoR2Path)' == '' And ('$(OS)' == 'Windows_NT')">C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2</RoR2Path>
    <RoR2ManagedPath>$(RoR2Path)\Risk of Rain 2_Data\Managed</RoR2ManagedPath>
    <BepInExCorePath>$(RoR2Path)\BepInEx\core</BepInExCorePath>
    <BepInExPluginPath>$(RoR2Path)\BepInEx\plugins</BepInExPluginPath>
  </PropertyGroup>

  <!--
    Автоопределение пути к игре через реестр Steam (HKLM\SOFTWARE\WOW6432Node\Valve\Steam -> InstallPath)
    и библиотеки Steam (libraryfolders.vdf), если явный путь не задан или невалиден.
    Выполняется только на Windows и только когда Assembly-CSharp.dll по текущему пути не найден.
  -->
  <Target Name="AutoDetectRoR2Path" BeforeTargets="DiagnoseGameReferences;ResolveAssemblyReferences"
          Condition="'$(OS)' == 'Windows_NT' And !Exists('$(RoR2ManagedPath)\Assembly-CSharp.dll')">
    <!-- reg query возвращает строку вида: "...    InstallPath    REG_SZ    C:\Program Files (x86)\Steam" -->
    <Exec Command='reg query "HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Valve\Steam" /v InstallPath'
          IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SteamRegOut" />
    </Exec>
    <PropertyGroup>
      <_SteamInstallRaw Condition="'$(_SteamRegOut)' != '' And $(_SteamRegOut.Contains('REG_SZ'))">$(_SteamRegOut.Substring($(_SteamRegOut.LastIndexOf('REG_SZ')) + 6).Trim())</_SteamInstallRaw>
      <_SteamAppPath Condition="'$(_SteamInstallRaw)' != ''">$(_SteamInstallRaw.TrimEnd('\'))\steamapps\common\Risk of Rain 2</_SteamAppPath>
      <RoR2Path Condition="'$(_SteamAppPath)' != '' And Exists('$(_SteamAppPath)\Risk of Rain 2_Data\Managed\Assembly-CSharp.dll')">$(_SteamAppPath)</RoR2Path>
      <RoR2ManagedPath>$(RoR2Path)\Risk of Rain 2_Data\Managed</RoR2ManagedPath>
      <BepInExCorePath>$(RoR2Path)\BepInEx\core</BepInExCorePath>
      <BepInExPluginPath>$(RoR2Path)\BepInEx\plugins</BepInExPluginPath>
    </PropertyGroup>
    <Message Importance="high" Condition="Exists('$(RoR2ManagedPath)\Assembly-CSharp.dll')"
             Text="[RoR2FirstPersonBrawler] Путь к игре определён автоматически: $(RoR2Path)" />
  </Target>

  <!--
    Ссылки на DLL игры. ДВА режима:

    Режим A (рекомендуемый, «ручной»): создайте рядом с csproj папку lib\
    и скопируйте в неё нужные DLL (список ниже). Тогда пути к игре вообще
    не нужны — сборка полностью автономна и одинакова на любой машине.

    Режим B: ссылки через путь к игре $(RoR2Path) (переменная окружения
    RoR2_PATH или файл .csproj.user; см. README).
    Если DLL нет ни в lib\, ни по пути к игре — включите режим A и
    скопируйте файлы вручную (инструкция в README, раздел «Ручное
    подключение зависимостей»).
  -->
  <ItemGroup>
    <!-- Системные сборки net35 (берутся из targeting pack NuGet-пакета
         Microsoft.NETFramework.ReferenceAssemblies — ставить что-либо руками не нужно) -->
    <Reference Include="System" />
    <Reference Include="System.Core" />

    <!-- UnityEngine.dll (legacy-сборка, Version=0.0.0.0, Culture=neutral).
         Обязателен даже когда подключены UnityEngine.*Module: классы из
         Assembly-CSharp.dll (CharacterBase и др.) наследуют MonoBehaviour именно
         из UnityEngine.dll, поэтому без этой ссылки компилятор выдаёт ошибку
         «Тип "MonoBehaviour" определен в сборке, на которую нет ссылки».
         В режиме B ссылка добавляется ниже; в режиме A (есть DLL в lib\) —
         через glob lib\*.dll, отдельная запись здесь не нужна. -->
  </ItemGroup>

  <PropertyGroup>
    <!-- Режим A активен, если в lib\ есть хотя бы одна DLL -->
    <HasLibMode Condition="Exists('$(LibRefPath)') And '$(HasLibMode)' == ''">true</HasLibMode>
  </PropertyGroup>

  <!--
    Проверка подлинности ключевых сборок в lib\.
    Предыдущая версия проекта могла оставить в lib\ СИНТЕТИЧЕСКУЮ facade-сборку
    UnityEngine.dll (создавалась целевым элементом GenerateUnityEngineFacade, когда
    настоящего файла не было). Компилятор принимает её вместо настоящей сборки, и
    тогда все типы цепочки наследования из Assembly-CSharp (BuffDef, HealthComponent,
    CharacterBase...) становятся «не найдены в пространстве имён RoR2».
    Признак подделки: файл меньше ~1 МБ (настоящий UnityEngine.dll — сотни КБ…МБ).
    Если обнаружена facade-сборка — удаляем её и показываем ошибку с инструкцией.
  -->
  <Target Name="ValidateLibReferences" BeforeTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <!-- Порог в КБ: facade-заглушка предыдущей версии — единицы КБ; настоящие
           UnityEngine.dll / Assembly-CSharp.dll — сотни КБ…МБ -->
      <_FacadeSizeThresholdKb>100</_FacadeSizeThresholdKb>
    </PropertyGroup>
    <ItemGroup>
      <_LibCheck Include="Assembly-CSharp.dll;UnityEngine.dll;UnityEngine.CoreModule.dll;BepInEx.dll">
        <Full>$(LibRefPath)\%(Identity)</Full>
      </_LibCheck>
      <_LibCheck Update="@(_LibCheck)"
                 Size="$([System.IO.File]::ReadAllBytes('%(Full)').Length)"
                 Condition="Exists('%(Full)')" />
      <!-- Размер в КБ (деление даёт целочисленное значение; facade-заглушка ~несколько КБ) -->
      <_LibCheck Update="@(_LibCheck)"
                 SizeKb="$([MSBuild]::Divide('%(_LibCheck.Size)', 1024).ToString('0'))"
                 Condition="'%(_LibCheck.Size)' != ''" />
      <_FakeLibRefs Include="@(_LibCheck)"
                    Condition="'%(_LibCheck.SizeKb)' != '' And $([MSBuild]::ValueOrDefault('%(_LibCheck.SizeKb)','9999').CompareTo($([MSBuild]::ParseEvalString('$(_FacadeSizeThresholdKb)')))) &lt; 0" />
    </ItemGroup>
    <Delete Files="%(_FakeLibRefs.Full)" Condition="'@(_FakeLibRefs)' != ''" />
    <Error Condition="'@(_FakeLibRefs)' != ''"
           Text="[RoR2FirstPersonBrawler] В lib\ обнаружены НЕ НАСТОЯЩИЕ (синтетические facade-) сборки: @(_FakeLibRefs->'%(Identity)', ', '). Они были сгенерированы предыдущей версией проекта и удалены при сборке. Ошибки вида «тип BuffDef/HealthComponent не найден в RoR2» вызваны именно ими. Скопируйте настоящие DLL из &lt;игра&gt;\Risk of Rain 2_Data\Managed\ и &lt;игра&gt;\BepInEx\core\ в lib\ и пересоберите решение." />
  </Target>

  <!-- Fallback: если UnityEngine.dll отсутствует и в lib\, и в папке игры
       (например, зависимости скопированы выборочно), генерируем минимальную
       facade-сборку UnityEngine, Version=0.0.0.0 с типом MonoBehaviour.
       Этого достаточно, чтобы компилятор разрешил цепочку наследования из
       Assembly-CSharp; в рантайме BepInEx/Mono подставит настоящую сборку. -->
  <Target Name="GenerateUnityEngineFacade" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(LibRefPath)\UnityEngine.dll') And !Exists('$(RoR2ManagedPath)\UnityEngine.dll')">
    <MakeDir Directories="$(LibRefPath)" />
    <PropertyGroup>
      <_FacadeSrc>$(IntermediateOutputPath)UnityEngineFacade.cs</_FacadeSrc>
      <_FacadeDll>$(LibRefPath)\UnityEngine.dll</_FacadeDll>
      <_CscToolPath Condition="'$(CscToolPath)' == ''">$(MSBuildToolsPath)</_CscToolPath>
    </PropertyGroup>
    <WriteLinesToFile File="$(_FacadeSrc)" Overwrite="true"
      Lines="using System;%0Anamespace UnityEngine {%0A    public class Object {}%0A    public class Component : Object {}%0A    public class Behaviour : Component {}%0A    public class MonoBehaviour : Behaviour {}%0A}" />
    <Exec Command='"$(_CscToolPath)\csc.exe" /nologo /target:library /out:"$(_FacadeDll)" "$(_FacadeSrc)"'
          IgnoreExitCode="true" ContinueOnError="true" />
    <Message Importance="high" Condition="Exists('$(_FacadeDll)')"
             Text="[RoR2FirstPersonBrawler] UnityEngine.dll не найден — создана временная facade-сборка в lib\ (только для компиляции). Для корректной работы положите настоящий UnityEngine.dll из &lt;игра&gt;\Risk of Rain 2_Data\Managed\ в lib\." />
    <Warning Condition="!Exists('$(_FacadeDll)')"
             Text="[RoR2FirstPersonBrawler] Не удалось создать facade UnityEngine.dll (нет csc.exe по пути $(_CscToolPath)). Скопируйте UnityEngine.dll из Managed\ игры в lib\ вручную." />
  </Target>

  <!-- Режим A: всё, что лежит в lib\, становится ссылками автоматически -->
  <ItemGroup Condition="Exists('$(LibRefPath)')">
    <Reference Include="$(LibRefPath)\*.dll" />
  </ItemGroup>

  <!-- Режим B: те же сборки по путям игры — добавляются только если их НЕТ в lib\,
       иначе будет конфликт дубликатах ссылок (MSB3271/CS1701) -->
  <ItemGroup>
    <!-- BepInEx / Harmony -->
    <Reference Include="BepInEx" Condition="!Exists('$(LibRefPath)\BepInEx.dll')">
      <HintPath>$(BepInExCorePath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Legacy UnityEngine.dll (режим B): см. пояснение выше -->
    <Reference Include="UnityEngine" Condition="'$(HasLibMode)' != 'true' And !Exists('$(LibRefPath)\UnityEngine.dll')">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="!Exists('$(LibRefPath)\0Harmony.dll')">
      <HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- R2API -->
    <Reference Include="R2API" Condition="!Exists('$(LibRefPath)\R2API.dll')">
      <HintPath>$(BepInExPluginPath)\R2API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Игровые сборки -->
    <Reference Include="Assembly-CSharp" Condition="!Exists('$(LibRefPath)\Assembly-CSharp.dll')">
      <HintPath>$(RoR2ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="!Exists('$(LibRefPath)\UnityEngine.CoreModule.dll')">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule" Condition="!Exists('$(LibRefPath)\UnityEngine.AnimationModule.dll')">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule" Condition="!Exists('$(LibRefPath)\UnityEngine.PhysicsModule.dll')">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule" Condition="!Exists('$(LibRefPath)\UnityEngine.AssetBundleModule.dll')">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Ссылка UnityEngine.Networking НЕ добавляется: в текущих билдах RoR2
         (Unity 2019.4 LTS+) отдельной UNet-сборки в Managed\ нет, типы
         NetworkServer/NetworkIdentity/NetworkUserCharacterMotor находятся в
         Assembly-CSharp.dll. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Ресурсы мода: AssetBundle префаба, иконки, звуки (добавляются на этапе 3/5) -->
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\**" Condition="Exists('Assets')" />
  </ItemGroup>

  <!-- Post-build: копируем DLL + manifest в BepInEx/plugins для локального теста.
       Заменяет старый PostBuildEvent с xcopy: работает через нативные задачи MSBuild,
       корректно обрабатывает пробелы в путях и не требует cmd.exe. -->
  <Target Name="DeployToBepInEx" AfterTargets="Build"
          Condition="'$(RoR2Path)' != '' And Exists('$(BepInExPluginPath)')">
    <MakeDir Directories="$(BepInExPluginPath)\RoR2FirstPersonBrawler" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(BepInExPluginPath)\RoR2FirstPersonBrawler\"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)manifest.json"
          DestinationFolder="$(BepInExPluginPath)\RoR2FirstPersonBrawler\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
