<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Адаптация проекта под Visual Studio 2026 (Insiders).
    Изменения относительно версии под VS2022:
      * SDK-style csproj вместо legacy-формата (ToolsVersion/явный список <Compile>) —
        стандарт для MSBuild из VS2026 и dotnet CLI; все .cs подхватываются автоматически.
      * TargetFramework net35 сохранён — это требование Mono-рантайма Risk of Rain 2,
        а не версии Visual Studio.
      * LangVersion 12 — новый компилятор Roslyn из VS2026 позволяет использовать
        современный синтаксис C# поверх net35 (для старых файлов достаточно 7.3+,
        повышение безопасно: обратно совместимо).
      * Post-build копирование через целевые элементы MSBuild вместо cmd-обёртки xcopy —
        кроссплатформенно (работает и в VS Insiders на Windows Arm64 / в CodeSpaces),
        не «ломает» сборку, если путь к игре не задан.
      * Убраны жёсткие ссылки на $(MSBuildToolsPath) цели — их больше нет в SDK-проектах.
  -->

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>RoR2FirstPersonBrawler</RootNamespace>
    <AssemblyName>RoR2FirstPersonBrawler</AssemblyName>
    <LangVersion>12</LangVersion>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- В SDK-проектах по умолчанию включён GenerateAssemblyInfo: отключаем,
         чтобы атрибуты сборки остались под нашим контролем (при необходимости). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Не тянуть случайные NuGet-зависимости: все игровые референсы — локальные DLL.
         Единственный пакет — reference assemblies для net35 (аналог targeting pack из
         VS Installer; в VS2026 отдельный компонент ставить не нужно). -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <!-- Legacy API-совместимость поведения компилятора для UnityEngine-сборок -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!-- Критично для SDK-style проекта net35: без отключенияimplicit-ссылок на
         Microsoft.NETCore.App проект пытается разрешить System.* из .NET Core
         и сборка/IntelliSense падают ещё до компиляции игровых ссылок. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <!-- Сборка не должна «падать» только из-за отсутствующих DLL игры:
         сначала покажем внятную диагностику (см. Target DiagnoseGameReferences). -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3245;MSB3243</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!--
    Диагностика: если DLL игры/BepInEx не найдены, показываем ОДНО понятное
    сообщение со всеми недостающими файлами и текущим значением RoR2Path —
    вместо десятков безликих CS0246 («Не удалось найти тип ... RoR2/UnityEngine/BepInEx»).
    Причина именно в отсутствии путей к игре, а не в коде мода.
  -->
  <ItemGroup>
    <_GameRefFiles Include="$(RoR2ManagedPath)\Assembly-CSharp.dll;$(RoR2ManagedPath)\UnityEngine.CoreModule.dll;$(RoR2ManagedPath)\UnityEngine.AnimationModule.dll;$(RoR2ManagedPath)\UnityEngine.PhysicsModule.dll;$(RoR2ManagedPath)\UnityEngine.AssetBundleModule.dll;$(RoR2ManagedPath)\UnityEngine.Networking.dll;$(BepInExCorePath)\BepInEx.dll;$(BepInExCorePath)\0Harmony.dll;$(BepInExPluginPath)\R2API.dll" />
    <_MissingGameRefs Include="@(_GameRefFiles)" Condition="!Exists('%(Identity)')" />
  </ItemGroup>
  <Target Name="DiagnoseGameReferences" BeforeTargets="BeforeBuild;CoreCompile">
    <Error Condition="'@(_MissingGameRefs)' != '' And '$(DiagnoseOnly)' == 'true'"
           Text="RoR2Path = '$(RoR2Path)'. Отсутствуют файлы: @(_MissingGameRefs -> '%(Filename)%(Extension)', ' | '). Исправьте путь (RoR2_PATH / csproj.user) и перезапустите Visual Studio." />
    <Warning Condition="'@(_MissingGameRefs)' != ''"
             Text="[RoR2FirstPersonBrawler] ВНИМАНИЕ: не найдено @( _MissingGameRefs -> '%(Filename)%(Extension)', ', '). Текущий RoR2Path = '$(RoR2Path)'. Ошибки CS0246 (неизвестные типы RoR2/UnityEngine/BepInEx) вызваны ИМЕННО отсутствием этих DLL, а не кодом. См. README ('Путь к игре') — после смены пути нужно закрыть VS, удалить bin/obj/.vs и заново открыть решение." />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!--
    Путь к установленной игре задаётся одним из способов (в порядке приоритета):
      1. RoR2FirstPersonBrawler.csproj.user  ->  <RoR2Path>...</RoR2Path>  (не в git)
      2. Переменная окружения RoR2_PATH
      3. Значение по умолчанию: стандартная Steam-директория
  -->
  <PropertyGroup>
    <!-- Убираем возможные хвостовые обратные слеши (частая причина «путь не найден»,
         особенно при копировании из проводника: "D:\Steam\Risk of Rain 2\") -->
    <RoR2Path Condition="'$(RoR2Path)' != ''">$(RoR2Path.TrimEnd('\'))</RoR2Path>
    <RoR2Path Condition="'$(RoR2Path)' == '' And '$(RoR2_PATH)' != ''">$(RoR2_PATH.TrimEnd('\'))</RoR2Path>
    <RoR2Path Condition="'$(RoR2Path)' == '' And ('$(OS)' == 'Windows_NT')">C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2</RoR2Path>
    <RoR2ManagedPath>$(RoR2Path)\Risk of Rain 2_Data\Managed</RoR2ManagedPath>
    <BepInExCorePath>$(RoR2Path)\BepInEx\core</BepInExCorePath>
    <BepInExPluginPath>$(RoR2Path)\BepInEx\plugins</BepInExPluginPath>
  </PropertyGroup>

  <!--
    Автоопределение пути к игре через реестр Steam (HKLM\SOFTWARE\WOW6432Node\Valve\Steam -> InstallPath)
    и библиотеки Steam (libraryfolders.vdf), если явный путь не задан или невалиден.
    Выполняется только на Windows и только когда Assembly-CSharp.dll по текущему пути не найден.
  -->
  <Target Name="AutoDetectRoR2Path" BeforeTargets="DiagnoseGameReferences;ResolveAssemblyReferences"
          Condition="'$(OS)' == 'Windows_NT' And !Exists('$(RoR2ManagedPath)\Assembly-CSharp.dll')">
    <!-- reg query возвращает строку вида: "...    InstallPath    REG_SZ    C:\Program Files (x86)\Steam" -->
    <Exec Command='reg query "HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Valve\Steam" /v InstallPath'
          IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SteamRegOut" />
    </Exec>
    <PropertyGroup>
      <_SteamInstallRaw Condition="'$(_SteamRegOut)' != '' And $(_SteamRegOut.Contains('REG_SZ'))">$(_SteamRegOut.Substring($(_SteamRegOut.LastIndexOf('REG_SZ')) + 6).Trim())</_SteamInstallRaw>
      <_SteamAppPath Condition="'$(_SteamInstallRaw)' != ''">$(_SteamInstallRaw.TrimEnd('\'))\steamapps\common\Risk of Rain 2</_SteamAppPath>
      <RoR2Path Condition="'$(_SteamAppPath)' != '' And Exists('$(_SteamAppPath)\Risk of Rain 2_Data\Managed\Assembly-CSharp.dll')">$(_SteamAppPath)</RoR2Path>
      <RoR2ManagedPath>$(RoR2Path)\Risk of Rain 2_Data\Managed</RoR2ManagedPath>
      <BepInExCorePath>$(RoR2Path)\BepInEx\core</BepInExCorePath>
      <BepInExPluginPath>$(RoR2Path)\BepInEx\plugins</BepInExPluginPath>
    </PropertyGroup>
    <Message Importance="high" Condition="Exists('$(RoR2ManagedPath)\Assembly-CSharp.dll')"
             Text="[RoR2FirstPersonBrawler] Путь к игре определён автоматически: $(RoR2Path)" />
  </Target>

  <ItemGroup>
    <!-- BepInEx / Harmony -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCorePath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- R2API и его подмодули -->
    <Reference Include="R2API">
      <HintPath>$(BepInExPluginPath)\R2API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Игровые сборки -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RoR2ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Networking">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.Networking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ресурсы мода: AssetBundle префаба, иконки, звуки (добавляются на этапе 3/5) -->
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\**" Condition="Exists('Assets')" />
  </ItemGroup>

  <!-- Post-build: копируем DLL + manifest в BepInEx/plugins для локального теста.
       Заменяет старый PostBuildEvent с xcopy: работает через нативные задачи MSBuild,
       корректно обрабатывает пробелы в путях и не требует cmd.exe. -->
  <Target Name="DeployToBepInEx" AfterTargets="Build"
          Condition="'$(RoR2Path)' != '' And Exists('$(BepInExPluginPath)')">
    <MakeDir Directories="$(BepInExPluginPath)\RoR2FirstPersonBrawler" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(BepInExPluginPath)\RoR2FirstPersonBrawler\"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)manifest.json"
          DestinationFolder="$(BepInExPluginPath)\RoR2FirstPersonBrawler\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
