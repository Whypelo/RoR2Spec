<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Адаптация проекта под Visual Studio 2026 (Insiders).
    Изменения относительно версии под VS2022:
      * SDK-style csproj вместо legacy-формата (ToolsVersion/явный список <Compile>) —
        стандарт для MSBuild из VS2026 и dotnet CLI; все .cs подхватываются автоматически.
      * TargetFramework net35 сохранён — это требование Mono-рантайма Risk of Rain 2,
        а не версии Visual Studio.
      * LangVersion 12 — новый компилятор Roslyn из VS2026 позволяет использовать
        современный синтаксис C# поверх net35 (для старых файлов достаточно 7.3+,
        повышение безопасно: обратно совместимо).
      * Post-build копирование через целевые элементы MSBuild вместо cmd-обёртки xcopy —
        кроссплатформенно (работает и в VS Insiders на Windows Arm64 / в CodeSpaces),
        не «ломает» сборку, если путь к игре не задан.
      * Убраны жёсткие ссылки на $(MSBuildToolsPath) цели — их больше нет в SDK-проектах.
  -->

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>RoR2FirstPersonBrawler</RootNamespace>
    <AssemblyName>RoR2FirstPersonBrawler</AssemblyName>
    <LangVersion>12</LangVersion>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- В SDK-проектах по умолчанию включён GenerateAssemblyInfo: отключаем,
         чтобы атрибуты сборки остались под нашим контролем (при необходимости). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Не тянуть случайные NuGet-зависимости: все игровые референсы — локальные DLL.
         Единственный пакет — reference assemblies для net35 (аналог targeting pack из
         VS Installer; в VS2026 отдельный компонент ставить не нужно). -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- RoR2/BepInEx — x86-сборки (MSIL без 32BITREQUIRED), поэтому сам плагин
         тоже компилируется как x86 (AnyCPU+Prefer32Bit в net35 не поддерживается).
         Это убирает предупреждение MSB3270 «несоответствие архитектур MSIL/x86». -->
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyOriginatorKeyFile></AssemblyOriginatorKeyFile>
    <!-- КРИТИЧНО для VS2026/dotnet SDK: НЕ отключаем SDK-Roslyn и НЕ подменяем
         компилятор нативным csc.exe v4.0 — это вызывало fatal CS2007
         «Нераспознанный параметр /sdkpath:». Roslyn из VS полностью поддерживает
         целевой фреймворк net35. Настройки обхода MSB3268 — в Directory.Build.props. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <!-- Legacy API-совместимость поведения компилятора для UnityEngine-сборок -->
    <NoWarn>$(NoWarn);CS0618;MSB3277;MSB3268;CS1701;CS1702</NoWarn>
    <!-- Обход MSB3268/CS2007 настроен в Directory.Build.props в корне репозитория
         (отключение apt-фильтрации ссылок + отказ от shared compilation;
         компилятор выбирает сам MSBuild — без ручного CscToolPath). -->
    <!-- Критично для SDK-style проекта net35: без отключенияimplicit-ссылок на
         Microsoft.NETCore.App проект пытается разрешить System.* из .NET Core
         и сборка/IntelliSense падают ещё до компиляции игровых ссылок. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <!-- Сборка не должна «падать» только из-за отсутствующих DLL игры:
         сначала покажем внятную диагностику (см. Target DiagnoseGameReferences). -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3245;MSB3243</MSBuildWarningsAsMessages>
    <!-- Папка для «ручного» подключения зависимостей: все *.dll из неё
         становятся ссылками автоматически, путь к игре тогда не нужен. -->
    <LibRefPath>$(MSBuildProjectDirectory)\lib</LibRefPath>
  </PropertyGroup>

  <!--
    Диагностика: если DLL игры/BepInEx не найдены, показываем ОДНО понятное
    сообщение со всеми недостающими файлами и текущим значением RoR2Path —
    вместо десятков безликих CS0246 («Не удалось найти тип ... RoR2/UnityEngine/BepInEx»).
    Причина именно в отсутствии путей к игре, а не в коде мода.
  -->
  <Target Name="DiagnoseGameReferences" DependsOnTargets="AutoDetectRoR2Path" BeforeTargets="BeforeBuild;CoreCompile">
    <ItemGroup>
      <!-- Проверка выполняется ВНУТРИ target: на уровне глобального ItemGroup
       %(Identity) недоступен в Condition, что вызывало ошибку MSBuild
       «ссылка на встроенные метаданные "Identity" ... не разрешена в условии».
       Файл считается найденным, если он есть в lib\ ИЛИ по пути к игре. -->
      <!-- UnityEngine.Networking.dll намеренно НЕ включён: в современных билдах
           RoR2 (Unity 2019.4+) классической UNet-сборки нет — типы NetworkServer/
           NetworkIdentity реплицируются в Assembly-CSharp.dll. Мод использует их
           только оттуда, отдельная ссылка не требуется. -->
      <!-- UnityEngine.dll (legacy-сборка, Version=0.0.0.0) обязателен: в него
           ссылаются типы из Assembly-CSharp (например, CharacterBase : MonoBehaviour),
           и без него компилятор выдаёт «Тип "MonoBehaviour" определен в сборке, на
           которую нет ссылки». Если в Managed\ его нет — включите режим lib\ и
           положите UnityEngine.dll рядом (см. README). -->
      <_GameRefSpec Include="Assembly-CSharp.dll;UnityEngine.dll;UnityEngine.CoreModule.dll;UnityEngine.AnimationModule.dll;UnityEngine.PhysicsModule.dll;UnityEngine.AssetBundleModule.dll;BepInEx.dll;0Harmony.dll;R2API.dll" />
      <_FoundGameRefs Include="@(_GameRefSpec->'$(LibRefPath)\%(Identity)')" Condition="Exists('$(LibRefPath)\%(_GameRefSpec.Identity)')" />
      <_FoundGameRefs Include="@(_GameRefSpec->'$(RoR2ManagedPath)\%(Identity)')" Condition="Exists('$(RoR2ManagedPath)\%(_GameRefSpec.Identity)')" />
      <_FoundGameRefs Include="@(_GameRefSpec->'$(BepInExCorePath)\%(Identity)')" Condition="Exists('$(BepInExCorePath)\%(_GameRefSpec.Identity)')" />
      <_FoundGameRefs Include="@(_GameRefSpec->'$(BepInExPluginPath)\%(Identity)')" Condition="Exists('$(BepInExPluginPath)\%(_GameRefSpec.Identity)')" />
      <_MissingGameRefs Include="@(_GameRefSpec)" Exclude="@(_FoundGameRefs->'%(Filename)%(Extension)')" />
    </ItemGroup>
    <Error Condition="'@(_MissingGameRefs)' != '' And '$(DiagnoseOnly)' == 'true'"
           Text="Отсутствуют сборки: @(_MissingGameRefs, ' | '). RoR2Path = '$(RoR2Path)', lib\ = '$(LibRefPath)'. Скопируйте DLL в lib\ (см. README, раздел «Ручное подключение зависимостей») или задайте верный путь к игре." />
    <Warning Condition="'@(_MissingGameRefs)' != ''"
             Text="[RoR2FirstPersonBrawler] ВНИМАНИЕ: не найдено @(_MissingGameRefs, ', '). RoR2Path = '$(RoR2Path)', папка lib\ = '$(LibRefPath)'. Ошибки CS0246 (неизвестные типы RoR2/UnityEngine/BepInEx) вызваны ИМЕННО отсутствием этих DLL, а не кодом. Проще всего скопировать их в lib\ — см. README, раздел «Ручное подключение зависимостей»." />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!--
    Путь к установленной игре задаётся одним из способов (в порядке приоритета):
      1. RoR2FirstPersonBrawler.csproj.user  ->  <RoR2Path>...</RoR2Path>  (не в git)
      2. Переменная окружения RoR2_PATH
      3. Значение по умолчанию: стандартная Steam-директория
  -->
  <PropertyGroup>
    <!-- Убираем возможные хвостовые обратные слеши (частая причина «путь не найден»,
         особенно при копировании из проводника: "D:\Steam\Risk of Rain 2\") -->
    <RoR2Path Condition="'$(RoR2Path)' != ''">$(RoR2Path.TrimEnd('\'))</RoR2Path>
    <RoR2Path Condition="'$(RoR2Path)' == '' And '$(RoR2_PATH)' != ''">$(RoR2_PATH.TrimEnd('\'))</RoR2Path>
    <!-- КРИТИЧНО: дефолтный путь ВСЕГДА вычисляется (даже если в итоге будет
         переопределён автодетектом). Причина: условие на элементе <Reference>
         вычисляется при ЗАГРУЗКЕ проекта, ДО выполнения любых target'ов; если бы
         свойство было пустым на этапе загрузки, ссылки режима B вообще не
         создавались бы — и никакое автоопределение в target их бы не вернуло
         (именно так возникали массовые CS0246 «тип не найден в RoR2»). -->
    <RoR2Path Condition="('$(RoR2Path)' == '' Or !Exists('$(RoR2Path)')) And ('$(OS)' == 'Windows_NT')">C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2</RoR2Path>
    <RoR2ManagedPath>$(RoR2Path)\Risk of Rain 2_Data\Managed</RoR2ManagedPath>
    <BepInExCorePath>$(RoR2Path)\BepInEx\core</BepInExCorePath>
    <BepInExPluginPath>$(RoR2Path)\BepInEx\plugins</BepInExPluginPath>
  </PropertyGroup>

  <!--
    Автоопределение пути к игре через реестр Steam (HKLM\SOFTWARE\WOW6432Node\Valve\Steam -> InstallPath)
    и библиотеки Steam (libraryfolders.vdf), если явный путь не задан или невалиден.
    Выполняется только на Windows и только когда Assembly-CSharp.dll по текущему пути не найден.
  -->
  <Target Name="AutoDetectRoR2Path" BeforeTargets="PurgeBrokenLibRefs;RequireCoreModuleInLib;ValidateLibReferences;RequireLibFiles;DiagnoseGameReferences;RecomputeGamePaths;ResolveAssemblyReferences"
          Condition="'$(OS)' == 'Windows_NT' And !Exists('$(RoR2ManagedPath)\Assembly-CSharp.dll')">
    <!-- КРИТИЧНО: все вычисления — внутри Exec/powershell, а НЕ в MSBuild-условиях.
         Причина: условие на элементе <Reference> вычисляется при ЗАГРУЗКЕ проекта,
         ДО выполнения любых target'ов. Предыдущая версия записывала RoR2Path из
         MSBuild-условия с Exists(...) — это условие проверялось для СТАРОГО
         (дефолтного C:\) пути, оставалось ложным, и автоскан реестра/библиотек
         Steam фактически никогда не применялся: в логе было видно определённый
         InstallPath F:\Steam, но ссылки всё равно шли на C:\Program Files (x86).
         Теперь PowerShell сам перебирает библиотеки Steam и печатает найденный
         путь одной строкой stdout, которая безусловно присваивается свойству. -->
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\FindRoR2Path.ps1&quot;"
          IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DetectedRoR2Path" />
    </Exec>
    <PropertyGroup>
      <RoR2Path Condition="'$(_DetectedRoR2Path)' != ''">$(_DetectedRoR2Path)</RoR2Path>
      <RoR2ManagedPath>$(RoR2Path)\Risk of Rain 2_Data\Managed</RoR2ManagedPath>
      <BepInExCorePath>$(RoR2Path)\BepInEx\core</BepInExCorePath>
      <BepInExPluginPath>$(RoR2Path)\BepInEx\plugins</BepInExPluginPath>
    </PropertyGroup>
    <Message Importance="high" Condition="'$(_DetectedRoR2Path)' != '' And Exists('$(RoR2ManagedPath)\Assembly-CSharp.dll')"
             Text="[RoR2FirstPersonBrawler] Путь к игре определён автоматически: $(RoR2Path)" />
    <Message Importance="high" Condition="'$(_DetectedRoR2Path)' == ''"
             Text="[RoR2FirstPersonBrawler] ВНИМАНИЕ: игра не найдена ни по умолчанию ($(RoR2Path)), ни в реестре/библиотеках Steam. Задайте путь явно: переменная окружения RoR2_PATH или файл csproj.user (&lt;RoR2Path&gt;...&lt;/RoR2Path&gt;) — см. README." />
  </Target>

  <!--
    Ссылки на DLL игры. ДВА режима:

    Режим A (рекомендуемый, «ручной»): создайте рядом с csproj папку lib\
    и скопируйте в неё нужные DLL (список ниже). Тогда пути к игре вообще
    не нужны — сборка полностью автономна и одинакова на любой машине.

    Режим B: ссылки через путь к игре $(RoR2Path) (переменная окружения
    RoR2_PATH или файл .csproj.user; см. README).
    Если DLL нет ни в lib\, ни по пути к игре — включите режим A и
    скопируйте файлы вручную (инструкция в README, раздел «Ручное
    подключение зависимостей»).
  -->
  <ItemGroup>
    <!-- Системные сборки net35 (берутся из targeting pack NuGet-пакета
         Microsoft.NETFramework.ReferenceAssemblies — ставить что-либо руками не нужно) -->
    <Reference Include="System" />
    <Reference Include="System.Core" />

    <!-- UnityEngine.dll (legacy-сборка, Version=0.0.0.0, Culture=neutral).
         Обязателен даже когда подключены UnityEngine.*Module: классы из
         Assembly-CSharp.dll (CharacterBase и др.) наследуют MonoBehaviour именно
         из UnityEngine.dll, поэтому без этой ссылки компилятор выдаёт ошибку
         «Тип "MonoBehaviour" определен в сборке, на которую нет ссылки».
         В режиме B ссылка добавляется ниже; в режиме A (есть DLL в lib\) —
         через glob lib\*.dll, отдельная запись здесь не нужна. -->
  </ItemGroup>

  <PropertyGroup>
    <!-- ВАЖНО: ссылки на DLL игры выбираются по ФАКТУ ПРЕДСТАВЛЕНИЯ каждого файла
         (Exists(...) на уровне элемента <Reference>), а НЕ по флагу режима.
         Это принципиально: ранее режим A включался наличием ЛЮБОГО файла в lib\,
         и «битые» урезанные DLL из zip-архива GitHub (Assembly-CSharp.dll ~134 КБ
         вместо нескольких МБ, UnityEngine.dll ~109 КБ, BepInEx.dll ~132 КБ)
         перехватывали все ссылки — отсюда массовые CS0246 («тип BuffDef/HealthComponent
         не найден в RoR2», «NetworkServer не существует») даже при корректно
         определённом пути к игре. Такие файлы теперь автоматически удаляются
         target'ом PurgeBrokenLibRefs (порог 500 КБ), а ссылки по путям игры
         подхватываются теми же Exists-условиями сразу после удаления. -->
    <HasLibMode Condition="Exists('$(LibRefPath)\Assembly-CSharp.dll')">true</HasLibMode>
  </PropertyGroup>

  <!--
    Очистка заведомо битых сборок в lib\: файлы меньше порога (заглушки из
    прошлых версий проекта или урезанные DLL из zip-архива репозитория).
    Выполняется ДО RequireCoreModuleInLib/ValidateLibReferences/ResolveAssemblyReferences.
    Ссылки выбираются по Exists() на уровне элемента, поэтому после удаления
    битых файлов те же сборки автоматически подхватываются по путям игры
    (режим B) — отдельное снятие ссылок не требуется.
  -->
  <Target Name="PurgeBrokenLibRefs" DependsOnTargets="AutoDetectRoR2Path;RecomputeGamePaths"
          BeforeTargets="RequireCoreModuleInLib;ValidateLibReferences;RequireLibFiles;DiagnoseGameReferences;ResolveAssemblyReferences"
          Condition="Exists('$(LibRefPath)')">
    <!-- Имя файла записывается в stdout ТОЛЬКО если он реально удалён (проверка
         Test-Path после Remove-Item). Это важно: при инкрементальной сборке target
         выполняется повторно, файлы уже настоящие — и ложный список "PURGED" не
         формируется. -->
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$t=[int64]500000; Get-ChildItem -LiteralPath '$(LibRefPath)' -Filter *.dll | Where-Object { $_.Length -lt $t } | ForEach-Object { $f=$_.FullName; $n=$_.Name; $l=$_.Length; Remove-Item -LiteralPath $f -Force -ErrorAction SilentlyContinue; if(-not (Test-Path -LiteralPath $f)){ Write-Output ($n + '=' + $l) } }&quot;"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_PurgedLibLines" />
    </Exec>
    <Message Importance="high" Condition="'@(_PurgedLibLines)' != ''"
             Text="[RoR2FirstPersonBrawler] ВНИМАНИЕ: из lib\ удалены слишком маленькие (ненастоящие) сборки: @(_PurgedLibLines, ', '). Это DLL-заглушки (например, из zip-архива GitHub вместо файлов из установленной игры). Скопируйте настоящие файлы: &lt;игра&gt;\Risk of Rain 2_Data\Managed\Assembly-CSharp.dll (несколько МБ!), UnityEngine.dll, UnityEngine.CoreModule.dll и &lt;игра&gt;\BepInEx\core\BepInEx.dll. После копирования пересоберите решение." />
  </Target>


  <!--
    КРИТИЧНО: после автоопределения пути к игре (AutoDetectRoR2Path) пересчитать
    производные пути RoR2ManagedPath/BepInExCorePath/BepInExPluginPath — иначе
    ссылки режима B будут указывать на несуществующий путь по умолчанию
    (C:\Program Files (x86)\Steam\...), даже когда игра реально установлена в
    другой библиотеке Steam (например, F:\Steam). Именно это вызывало массовые
    CS0246 «тип не найден в RoR2» при корректно определённом InstallPath.
    Важно: выполняется как Target (после AutoDetectRoR2Path), а не как глобальный
    PropertyGroup — иначе MSBuild подставил бы сюда СТАРЫЙ (дефолтный) RoR2Path,
    перечёркивая результат автоопределения.
  -->
  <Target Name="RecomputeGamePaths" AfterTargets="AutoDetectRoR2Path" BeforeTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <RoR2ManagedPath>$(RoR2Path)\Risk of Rain 2_Data\Managed</RoR2ManagedPath>
      <BepInExCorePath>$(RoR2Path)\BepInEx\core</BepInExCorePath>
      <BepInExPluginPath>$(RoR2Path)\BepInEx\plugins</BepInExPluginPath>
      <_DefaultSteamPathPrefix>C:\Program Files (x86)\Steam</_DefaultSteamPathPrefix>
      <_IsDefaultSteamPath Condition="$(RoR2ManagedPath.StartsWith($(_DefaultSteamPathPrefix)))">true</_IsDefaultSteamPath>
      <_IsDefaultSteamPath Condition="'$(_IsDefaultSteamPath)' != 'true'">false</_IsDefaultSteamPath>
    </PropertyGroup>
    <!-- КРИТИЧНО: обновляем HintPath у ссылок режима B ЯВНО (item update), потому что
         условие/HintPath элемента <Reference> вычислялись при загрузке проекта — со
         СТАРЫМ (дефолтным C:\) значением RoR2Path. Без этого шага автоопределение пути
         к игре не применялось к уже созданным ссылкам: в логе был определён InstallPath
         F:\Steam, а Assembly-CSharp.dll искался в C:\Program Files (x86)... -->
    <ItemGroup>
      <!-- КРИТИЧНО: ссылки режима B пересоздаются ЗАНОВО (Include, а не update).
           Изначальные элементы создавались при загрузке проекта с дефолтным
           C:\Program Files (x86)\Steam — автоопределение пути к игре их бы не
           затронуло. Здесь Include-условие вычисляется уже ПОСЛЕ AutoDetectRoR2Path,
           поэтому берётся реальный путь; Remove-список снимает «дефолтные» дубликаты
           (иначе был бы MSB3105 о повторных ссылках). -->
      <Reference Remove="Assembly-CSharp;UnityEngine;UnityEngine.CoreModule;UnityEngine.AnimationModule;UnityEngine.PhysicsModule;UnityEngine.AssetBundleModule;BepInEx;0Harmony;R2API" />
      <Reference Include="BepInEx" Condition="!Exists('$(LibRefPath)\BepInEx.dll')">
        <HintPath>$(BepInExCorePath)\BepInEx.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine" Condition="!Exists('$(LibRefPath)\UnityEngine.dll')">
        <HintPath>$(RoR2ManagedPath)\UnityEngine.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="0Harmony" Condition="!Exists('$(LibRefPath)\0Harmony.dll')">
        <HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="R2API" Condition="!Exists('$(LibRefPath)\R2API.dll')">
        <HintPath>$(BepInExPluginPath)\R2API.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="Assembly-CSharp" Condition="!Exists('$(LibRefPath)\Assembly-CSharp.dll')">
        <HintPath>$(RoR2ManagedPath)\Assembly-CSharp.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.CoreModule" Condition="!Exists('$(LibRefPath)\UnityEngine.CoreModule.dll')">
        <HintPath>$(RoR2ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.AnimationModule" Condition="!Exists('$(LibRefPath)\UnityEngine.AnimationModule.dll')">
        <HintPath>$(RoR2ManagedPath)\UnityEngine.AnimationModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.PhysicsModule" Condition="!Exists('$(LibRefPath)\UnityEngine.PhysicsModule.dll')">
        <HintPath>$(RoR2ManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UnityEngine.AssetBundleModule" Condition="!Exists('$(LibRefPath)\UnityEngine.AssetBundleModule.dll')">
        <HintPath>$(RoR2ManagedPath)\UnityEngine.AssetBundleModule.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
    <Message Importance="high" Text="[RoR2FirstPersonBrawler] Managed-путь для ссылок: $(RoR2ManagedPath)" />
  </Target>

  <!--
    КРИТИЧНО для режима A: UnityEngine.CoreModule.dll (и прочие *Module) должны быть
    в lib\ ОБЯЗАТЕЛЬНО. В Mono-сборках RoR2 типы Component/MonoBehaviour/GameObject
    объявлены именно в CoreModule, а legacy UnityEngine.dll содержит только type-forwards.
    Если CoreModule отсутствует, компилятор берёт базовые классы из mscorlib-подобных
    заглушек и считает все типы Assembly-CSharp (BuffDef, HealthComponent, NetworkServer...)
    «не найденными в RoR2», хотя Assembly-CSharp.dll подключена.
    Проверка выполняется ДО удаления подозрительных файлов (см. ValidateLibReferences).
  -->
  <Target Name="RequireCoreModuleInLib" DependsOnTargets="AutoDetectRoR2Path" BeforeTargets="ValidateLibReferences;ResolveAssemblyReferences"
          Condition="Exists('$(LibRefPath)\Assembly-CSharp.dll') And !Exists('$(LibRefPath)\UnityEngine.CoreModule.dll')">
    <Error Text="[RoR2FirstPersonBrawler] В lib\ есть DLL, но ОТСУТСТВУЕТ UnityEngine.CoreModule.dll. Без неё ошибки «тип BuffDef/HealthComponent не найден в RoR2» неизбежны: базовые классы Component/MonoBehaviour живут именно в этой сборке. Скопируйте UnityEngine.CoreModule.dll из &lt;игра&gt;\Risk of Rain 2_Data\Managed\ в lib\ и пересоберите." />
  </Target>

  <!--
    Проверка подлинности ключевых сборок в lib\.
    Признак подделки/facade-заглушки: размер файла менее ~100 КБ.
    Настоящие UnityEngine.dll / Assembly-CSharp.dll — сотни КБ…МБ.
    Поддельные файлы удаляются автоматически, выводится ошибка с инструкцией.
    Target вызывается только если в lib\ есть хотя бы одна реальная DLL
    (HasLibMode == true); пустая папка lib\ (с .gitkeep) игнорируется.
  -->
  <Target Name="ValidateLibReferences" DependsOnTargets="AutoDetectRoR2Path" BeforeTargets="ResolveAssemblyReferences"
          Condition="Exists('$(LibRefPath)\Assembly-CSharp.dll')">
    <PropertyGroup>
      <!-- Порог в байтах: заглушки — единицы КБ; настоящие DLL — сотни КБ…МБ -->
      <_FacadeSizeThresholdBytes>102400</_FacadeSizeThresholdBytes>
    </PropertyGroup>
    <!-- Получаем размеры файлов (в байтах) через Get-Item.Length.
         Property-функции вида $([System.IO.File]::...('%(Item)')) MSBuild не вычисляет
         поэлементно, а inline-таски не умеют возвращать значения в metadata — поэтому
         вывод парсится из stdout Exec. Путь передаётся как аргумент скрипта, чтобы
         избежать проблем с кавычками/пробелами. -->
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$names = @('Assembly-CSharp.dll','UnityEngine.dll','UnityEngine.CoreModule.dll','BepInEx.dll'); foreach($n in $names){ $p = Join-Path -Path ([IO.Path]::GetFullPath('$(LibRefPath)')) -ChildPath $n; if(Test-Path -LiteralPath $p -PathType Leaf){ Write-Output ($n + '=' + (Get-Item -LiteralPath $p).Length) } }&quot;"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_LibSizeLines" />
    </Exec>
    <ItemGroup Condition="'@(_LibSizeLines)' != ''">
      <_FakeLibRefs Include="%(_LibSizeLines.Identity)"
                    Condition="$([MSBuild]::Divide([System.Int64]::Parse('%(Identity)'.Split('=').Last()), 1).ToString('0')) != '' And
                             [System.Int64]::Parse('%(Identity)'.Split('=').Last()).CompareTo($([MSBuild]::ParseEvalString('$(_FacadeSizeThresholdBytes)'))) &lt; 0">
        <DllName>%(_FakeLibRefs.Identity.Split('=').First())</DllName>
        <Full>$(LibRefPath)\%(_FakeLibRefs.DllName)</Full>
      </_FakeLibRefs>
    </ItemGroup>
    <Delete Files="%(_FakeLibRefs.Full)" Condition="'@(_FakeLibRefs)' != ''" />
    <Error Condition="'@(_FakeLibRefs)' != ''"
           Text="[RoR2FirstPersonBrawler] В lib\ обнаружены НЕ НАСТОЯЩИЕ (синтетические facade-) сборки: @(_FakeLibRefs->'%(DllName)', ', '). Они были сгенерированы предыдущей версией проекта и удалены при сборке. Ошибки вида «тип BuffDef/HealthComponent не найден в RoR2» вызваны именно ими. Скопируйте настоящие DLL из &lt;игра&gt;\Risk of Rain 2_Data\Managed\ и &lt;игра&gt;\BepInEx\core\ в lib\ и пересоберите решение." />
  </Target>

  <ItemGroup>
    <!-- Не глоб lib\*.dll: лишние/старые сборки (например, UnityEngine.Networking.dll
         из старых версий игры) вызывали конфликты. Список фиксированный; при сборке
         проверяется существование каждого файла, недостающие — понятная ошибка. -->
    <Reference Include="Assembly-CSharp" Condition="Exists('$(LibRefPath)\Assembly-CSharp.dll')">
      <HintPath>$(LibRefPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(LibRefPath)\UnityEngine.dll')">
      <HintPath>$(LibRefPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(LibRefPath)\UnityEngine.CoreModule.dll')">
      <HintPath>$(LibRefPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule" Condition="Exists('$(LibRefPath)\UnityEngine.AnimationModule.dll')">
      <HintPath>$(LibRefPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule" Condition="Exists('$(LibRefPath)\UnityEngine.PhysicsModule.dll')">
      <HintPath>$(LibRefPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule" Condition="Exists('$(LibRefPath)\UnityEngine.AssetBundleModule.dll')">
      <HintPath>$(LibRefPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx" Condition="Exists('$(LibRefPath)\BepInEx.dll')">
      <HintPath>$(LibRefPath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="Exists('$(LibRefPath)\0Harmony.dll')">
      <HintPath>$(LibRefPath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="R2API" Condition="Exists('$(LibRefPath)\R2API.dll')">
      <HintPath>$(LibRefPath)\R2API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Режим A: обязательные DLL должны физически присутствовать в lib\.
       Отсутствие любого из них = массовые CS0246, поэтому останавливаем сборку
       с конкретным списком недостающих файлов ДО компиляции. -->
  <Target Name="RequireLibFiles" DependsOnTargets="AutoDetectRoR2Path" BeforeTargets="ValidateLibReferences;ResolveAssemblyReferences"
          Condition="Exists('$(LibRefPath)\Assembly-CSharp.dll')">
    <ItemGroup>
      <_RequiredLib Include="Assembly-CSharp.dll;UnityEngine.dll;UnityEngine.CoreModule.dll;BepInEx.dll" />
      <_MissingLib Include="@(_RequiredLib)" Exclude="$(LibRefPath)\@(_RequiredLib)" Condition="!Exists('$(LibRefPath)\%(_RequiredLib.Identity)')" />
    </ItemGroup>
    <Error Condition="'@(_MissingLib)' != ''"
           Text="[RoR2FirstPersonBrawler] В lib\ отсутствуют обязательные сборки: @(_MissingLib, ', '). Скопируйте их из &lt;игра&gt;\Risk of Rain 2_Data\Managed\ (Assembly-CSharp, UnityEngine, UnityEngine.CoreModule) и &lt;игра&gt;\BepInEx\core\ (BepInEx). Без UnityEngine.CoreModule.dll ошибки «BuffDef/HealthComponent не найдены в RoR2» неизбежны." />
  </Target>

  <!-- Режим B: те же сборки по путям игры — добавляются только если их НЕТ в lib\,
       иначе будет конфликт дубликатах ссылок (MSB3271/CS1701) -->
  <ItemGroup>
    <!-- BepInEx / Harmony -->
    <Reference Include="BepInEx" Condition="!Exists('$(LibRefPath)\BepInEx.dll')">
      <HintPath>$(BepInExCorePath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Legacy UnityEngine.dll (режим B): см. пояснение выше -->
    <Reference Include="UnityEngine" Condition="!Exists('$(LibRefPath)\UnityEngine.dll')">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="!Exists('$(LibRefPath)\0Harmony.dll')">
      <HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- R2API -->
    <Reference Include="R2API" Condition="!Exists('$(LibRefPath)\R2API.dll')">
      <HintPath>$(BepInExPluginPath)\R2API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Игровые сборки -->
    <Reference Include="Assembly-CSharp" Condition="!Exists('$(LibRefPath)\Assembly-CSharp.dll')">
      <HintPath>$(RoR2ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="!Exists('$(LibRefPath)\UnityEngine.CoreModule.dll')">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule" Condition="!Exists('$(LibRefPath)\UnityEngine.AnimationModule.dll')">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule" Condition="!Exists('$(LibRefPath)\UnityEngine.PhysicsModule.dll')">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule" Condition="!Exists('$(LibRefPath)\UnityEngine.AssetBundleModule.dll')">
      <HintPath>$(RoR2ManagedPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Ссылка UnityEngine.Networking НЕ добавляется: в текущих билдах RoR2
         (Unity 2019.4 LTS+) отдельной UNet-сборки в Managed\ нет, типы
         NetworkServer/NetworkIdentity/NetworkUserCharacterMotor находятся в
         Assembly-CSharp.dll. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Ресурсы мода: AssetBundle префаба, иконки, звуки (добавляются на этапе 3/5) -->
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\**" Condition="Exists('Assets')" />
  </ItemGroup>

  <!-- Post-build: копируем DLL + manifest в BepInEx/plugins для локального теста.
       Заменяет старый PostBuildEvent с xcopy: работает через нативные задачи MSBuild,
       корректно обрабатывает пробелы в путях и не требует cmd.exe. -->
  <Target Name="DeployToBepInEx" AfterTargets="Build"
          Condition="'$(RoR2Path)' != '' And Exists('$(BepInExPluginPath)')">
    <MakeDir Directories="$(BepInExPluginPath)\RoR2FirstPersonBrawler" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(BepInExPluginPath)\RoR2FirstPersonBrawler\"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)manifest.json"
          DestinationFolder="$(BepInExPluginPath)\RoR2FirstPersonBrawler\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
